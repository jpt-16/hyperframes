# Dependencies (gsap is pinned in package.json; vendor/ is committed so the
# composition renders from a fresh clone without an install)
node_modules/

# Personal source footage — deliberately not committed. The composition
# expects base_seo.mp4 at the project root; drop your own file in and update
# the src on #a-roll / #a-roll-audio.
*.mp4
*.mov
!vendor/*.js

# Render output — regenerable, and the MP4 carries the speaker's footage
renders/

# Review artifacts — these are frames of the speaker's face
snapshots/
